{
  "name": "codex-orka",
  "version": "1.0.0",
  "description": "Wishfire: the browser game as one Rust app (rust/wf_app) over the wf_combat simulation, plus repo tooling.",
  "scripts": {
    "test": "node tools/run_test_suite.mjs",
    "build": "bash tools/build_wf_app.sh",
    "serve": "bash tools/serve_wf_app.sh 8807",
    "build:release": "node tools/build_runtime_release.mjs",
    "storage:audit": "node tools/storage_hygiene.mjs audit",
    "storage:clean": "node tools/storage_hygiene.mjs clean",
    "footprint:start": "node tools/storage_hygiene.mjs footprint:start",
    "footprint:check": "node tools/storage_hygiene.mjs footprint:check",
    "footprint:peak": "node tools/storage_hygiene.mjs footprint:peak",
    "footprint:close": "node tools/storage_hygiene.mjs footprint:close",
    "footprint:register": "node tools/storage_hygiene.mjs footprint:register",
    "beads:link-worktree": "node tools/link_beads_worktree.mjs",
    "test:commit": "node tools/run_commit_tests.mjs",
    "test:merge": "bash tools/run_merge_tests.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "playwright": "^1.65.0"
  }
