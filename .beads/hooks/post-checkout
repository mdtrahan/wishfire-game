#!/usr/bin/env bash
set -u

# Beads remains the authoritative checkout hook. Graphify only runs after
# Beads has already finished and must never block checkout success.
if ! command -v bd >/dev/null 2>&1; then
  exit 0
fi

bd hooks run post-checkout "$@"
bd_status=$?
if [ "$bd_status" -ne 0 ]; then
  exit "$bd_status"
fi

if [ -x "tools/graphify_refresh.sh" ]; then
  GRAPHIFY_QUIET=1 tools/graphify_refresh.sh post-checkout "$@" || true
fi

exit 0
