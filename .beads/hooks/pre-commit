#!/usr/bin/env bash
set -euo pipefail

# Keep Beads native hook behavior.
if ! command -v bd >/dev/null 2>&1; then
  echo "ERROR: bd command not found in PATH." >&2
  exit 1
fi

bd hooks run pre-commit "$@"

# Enforce issue-gated workflow.
if ! bd ready --json >/tmp/bd_precommit_ready.json 2>/tmp/bd_precommit_ready.err; then
  echo "ERROR: bd ready failed. Run 'bd ready' and select a valid issue first." >&2
  cat /tmp/bd_precommit_ready.err >&2 || true
  exit 1
fi

if ! bd list --status=in_progress --json >/tmp/bd_precommit_inprogress.json 2>/tmp/bd_precommit_inprogress.err; then
  echo "ERROR: Unable to verify active in-progress issue." >&2
  cat /tmp/bd_precommit_inprogress.err >&2 || true
  exit 1
fi

if ! grep -q '"id"' /tmp/bd_precommit_inprogress.json; then
  echo "ERROR: No in-progress Beads issue found. Set one issue to in_progress before commit." >&2
  exit 1
fi

# Enforce commit-compliance prep for significant staged diffs.
if [ -x "tools/enforce_commit_check.sh" ]; then
  tools/enforce_commit_check.sh
else
  echo "ERROR: Missing executable tools/enforce_commit_check.sh required by significant-diff commit policy." >&2
  exit 1
fi

# Enforce hot-file lock + function-scope declarations.
if [ -x "tools/enforce_hot_file_scope.sh" ]; then
  tools/enforce_hot_file_scope.sh
else
  echo "ERROR: Missing executable tools/enforce_hot_file_scope.sh required by hot-file lock policy." >&2
  exit 1
fi

# Fail closed on presentation-owner changes. Vertical panel scrolling is allowed;
# horizontal overflow, blown-up controls, and legacy combat chrome are not.
# Owners: web-runner/app.js, web-runner/systems/renderRuntime.js,
# web-runner/systems/renderSkillDraughtOverlay.js, web-runner/systems/devToolingRuntime.js,
# web-runner/systems/combatPresentationScale.mjs, web-runner/systems/appShellViewport.js,
# web-runner/systems/surfaceRenderRouter.js, web-runner/systems/pointerRoutingShell.js,
# and web-runner/src/core/damageNumberAnimation.mjs.
UI_LOCK_OWNER_PATTERN='^(package\.json|tools/ui_presentation_lock_gate\.mjs|tests/uiPresentationLockGateContract\.test\.js|web-runner/index\.html|web-runner/app\.js|web-runner/src/core/damageNumberAnimation\.mjs|web-runner/systems/renderRuntime\.js|web-runner/systems/renderSkillDraughtOverlay\.js|web-runner/systems/devToolingRuntime\.js|web-runner/systems/combatPresentationScale\.mjs|web-runner/systems/appShellViewport\.js|web-runner/systems/surfaceRenderRouter\.js|web-runner/systems/pointerRoutingShell\.js)$'
UI_LOCK_STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMRD)"
if printf '%s\n' "$UI_LOCK_STAGED_FILES" | grep -Eq "$UI_LOCK_OWNER_PATTERN"; then
  echo "UI presentation owner changed; running rendered UI lock..."
  npm run test:ui-lock
fi
